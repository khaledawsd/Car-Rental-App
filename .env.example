# Copy to .env and fill in. .env is gitignored; never commit it.
#
# You do not need this file to try the app locally: `python app.py` generates a
# temporary key and prints a warning. You DO need it for anything a second
# person can reach, and the app enforces that -- it refuses to start under a
# WSGI server or bind a non-loopback address without a real SECRET_KEY.

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# SQLAlchemy connection string.
# Production:  postgresql+psycopg://user:pass@host:5432/carrental
DATABASE_URL=sqlite:///carrental.db

# Local development only. Enables the Werkzeug debugger, which is remote code
# execution if the port is ever reachable from outside the machine.
FLASK_DEBUG=0

# Send session cookies only over HTTPS. On by default once SECRET_KEY is set and
# FLASK_DEBUG is off; forced off for local runs, because a Secure cookie is not
# sent over http and login would fail with no visible reason.
# SESSION_COOKIE_SECURE=1

# Create missing tables at startup. Set to 0 once Alembic migrations exist.
AUTO_CREATE_DB=1

# Bind address. Anything other than loopback requires a real SECRET_KEY.
# HOST=127.0.0.1

# Rate-limit storage. memory:// is per-process; use redis://host:6379 for real
# deployments so limits are shared across workers.
RATELIMIT_STORAGE_URI=memory://

# Optional: lets `flask create-admin` run unattended instead of prompting.
# ADMIN_PASSWORD=
